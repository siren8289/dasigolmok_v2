# docker compose 실행에 필요한 값. 이 파일을 .env 로 복사해서 채운다.
DB_PASSWORD=change-me

# PostgreSQL + pgvector 연결 URL (AI 서비스용)
DATABASE_URL=postgresql://dasi:change-me@localhost:5432/dasigolmok

# 소상공인시장진흥공단 상가(상권)정보 API 인증키 (공공데이터포털)
DATA_GO_KR_KEY=

# LLM 설명 및 RAG(선택). 비워 두면 기본 규칙 설명이 나온다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
