DATABASE_URL="postgresql://app_user:app_password@localhost:5432/dasi_golmok"
NEXTAUTH_SECRET="dasi-golmok-dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
BACKEND_URL="http://localhost:8080"
APP_VERSION="0.1.0"

# FastAPI AI assist (optional; defaults off — Story CRUD works without it)
AI_ENABLED=false
AI_ADAPTER=disabled
AI_BASE_URL=http://localhost:8000
AI_PORT=8000
AI_TAG_SUGGEST_ENABLED=false
AI_SUMMARY_ENABLED=false
AI_CLASSIFY_ENABLED=false
AI_CURATION_ASSIST_ENABLED=false

# DB (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dasi_golmok
DB_USERNAME=app_user
DB_PASSWORD=app_password
